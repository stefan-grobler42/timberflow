modules = ["nodejs-20", "python-3.11", "python3", "dotnet-8", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["dotnet-sdk_8", "glibcLocales", "sqlite"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WebAPI"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "WebAPI"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend/MillenniumERP.API && dotnet run"
waitForPort = 8000

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 33853
externalPort = 8080

[[ports]]
localPort = 34841
externalPort = 3003

[[ports]]
localPort = 39531
externalPort = 4200

[[ports]]
localPort = 39651
externalPort = 3000

[[ports]]
localPort = 41803
externalPort = 6800

[[ports]]
localPort = 42089
externalPort = 8008

[[ports]]
localPort = 42333
externalPort = 5000

[[ports]]
localPort = 44323
externalPort = 6000

[[ports]]
localPort = 44829
externalPort = 3002

[[ports]]
localPort = 45249
externalPort = 5173

[[ports]]
localPort = 46561
externalPort = 3001

[deployment]
deploymentTarget = "cloudrun"

[agent]
expertMode = true
integrations = ["github:1.0.0"]
