modules = ["nodejs-20", "python-3.11", "python3", "dotnet-8", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["dotnet-sdk_8", "glibcLocales", "sqlite"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WebAPI"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "WebAPI"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend/MillenniumERP.API && dotnet run"
waitForPort = 8000

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
deploymentTarget = "autoscale"
run = ["dotnet", "backend/MillenniumERP.API/out/MillenniumERP.API.dll"]
build = ["bash", "-c", "cd frontend && npm install && npx vite build && cd .. && mkdir -p backend/MillenniumERP.API/wwwroot && cp -r frontend/dist/* backend/MillenniumERP.API/wwwroot/ && dotnet publish backend/MillenniumERP.API/MillenniumERP.API.csproj -c Release -o backend/MillenniumERP.API/out"]

[agent]
expertMode = true
integrations = ["github:1.0.0"]

[userenv]

[userenv.production]
ASPNETCORE_ENVIRONMENT = "Production"
