modules = ["nodejs-20", "python-3.11", "postgresql-16", "python3", "dotnet-8"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "dotnet-sdk_8"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WebAPI"

[[workflows.workflow]]
name = "WebAPI"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend/MillenniumERP.API && dotnet run"
waitForPort = 8000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 39651
externalPort = 3000

[[ports]]
localPort = 44357
externalPort = 3002

[[ports]]
localPort = 46561
externalPort = 3001

[deployment]
deploymentTarget = "cloudrun"

[agent]
expertMode = true
