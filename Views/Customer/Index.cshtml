@model IEnumerable<MillenniumERP.Models.CustomerViewModel>
@{
    ViewData["Title"] = "Customer Management";
    Layout = "_Layout";
}

<!-- Module Header -->
<div class="module-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Customers</li>
        </ol>
    </nav>
    <h1><i class="fas fa-user-tie text-primary"></i> Customer Management</h1>
</div>

<!-- Action Bar -->
<div class="action-bar">
    <div class="btn-group">
        <button type="button" class="btn btn-primary btn-sm" id="btnNew">
            <i class="fas fa-plus"></i> New
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm" id="btnEdit" disabled>
            <i class="fas fa-edit"></i> Edit
        </button>
        <button type="button" class="btn btn-outline-danger btn-sm" id="btnDelete" disabled>
            <i class="fas fa-trash"></i> Delete
        </button>
    </div>
    
    <div class="divider"></div>
    
    <div class="btn-group">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnRefresh">
            <i class="fas fa-sync"></i> Refresh
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnFilter">
            <i class="fas fa-filter"></i> Filter
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnColumns">
            <i class="fas fa-columns"></i> Columns
        </button>
    </div>
    
    <div class="divider"></div>
    
    <div class="btn-group">
        <button type="button" class="btn btn-outline-success btn-sm" id="btnExport">
            <i class="fas fa-file-excel"></i> Export
        </button>
        <button type="button" class="btn btn-outline-info btn-sm" id="btnImport">
            <i class="fas fa-file-import"></i> Import
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPrint">
            <i class="fas fa-print"></i> Print
        </button>
    </div>
    
    <div class="search-box">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" class="form-control" id="searchBox" placeholder="Search customers...">
        </div>
    </div>
</div>

<!-- Data Grid -->
<div class="data-grid-container">
    <table id="customerTable" class="table table-hover">
        <thead>
            <tr>
                <th width="40">
                    <input type="checkbox" id="selectAll" class="form-check-input">
                </th>
                <th>Account No</th>
                <th>Account Name</th>
                <th>Company Type</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Status</th>
                <th>Sales Rep</th>
                <th width="100">Actions</th>
            </tr>
        </thead>
        <tbody id="customerTableBody">
            <!-- Data will be loaded here -->
        </tbody>
    </table>
</div>

<!-- Customer Form Modal -->
<partial name="_CustomerForm" />

@section Scripts {
    <script>
        $(document).ready(function() {
            var selectedCustomers = [];
            var customerDataTable;
            
            // Initialize DataTable
            function initializeDataTable() {
                customerDataTable = $('#customerTable').DataTable({
                    ajax: {
                        url: '/api/customer',
                        dataSrc: ''
                    },
                    columns: [
                        {
                            data: null,
                            orderable: false,
                            render: function(data, type, row) {
                                return '<input type="checkbox" class="form-check-input row-select" value="' + row.id + '">';
                            }
                        },
                        { data: 'accountNo' },
                        { data: 'accountName' },
                        { data: 'companyType' },
                        { data: 'phone' },
                        { data: 'email' },
                        {
                            data: 'customerStatus',
                            render: function(data) {
                                var badgeClass = 'badge-status ';
                                if (data === 'Confirmed Customer') badgeClass += 'active';
                                else if (data === 'Account Closed') badgeClass += 'inactive';
                                else badgeClass += 'pending';
                                return '<span class="' + badgeClass + '">' + data + '</span>';
                            }
                        },
                        { data: 'salesRepresentative' },
                        {
                            data: null,
                            orderable: false,
                            render: function(data, type, row) {
                                return `
                                    <button class="btn btn-sm btn-outline-primary edit-btn" data-id="${row.id}" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger delete-btn" data-id="${row.id}" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                `;
                            }
                        }
                    ],
                    dom: 'rtip',
                    pageLength: 25,
                    order: [[1, 'asc']],
                    language: {
                        emptyTable: "No customers found",
                        info: "Showing _START_ to _END_ of _TOTAL_ customers",
                        infoEmpty: "No customers to show",
                        infoFiltered: "(filtered from _MAX_ total customers)"
                    }
                });
            }
            
            // Load customers
            function loadCustomers() {
                customerDataTable.ajax.reload();
            }
            
            // Initialize on page load
            initializeDataTable();
            
            // Search functionality
            $('#searchBox').on('keyup', function() {
                customerDataTable.search(this.value).draw();
            });
            
            // Select all checkbox
            $('#selectAll').on('change', function() {
                $('.row-select').prop('checked', this.checked);
                updateActionButtons();
            });
            
            // Row selection
            $(document).on('change', '.row-select', function() {
                updateActionButtons();
            });
            
            // Update action buttons based on selection
            function updateActionButtons() {
                var selectedCount = $('.row-select:checked').length;
                $('#btnEdit').prop('disabled', selectedCount !== 1);
                $('#btnDelete').prop('disabled', selectedCount === 0);
            }
            
            // New customer
            $('#btnNew').on('click', function() {
                $('#customerForm')[0].reset();
                $('#customerId').val('');
                $('#modalTitle').text('New Customer');
                $('#customerModal').modal('show');
            });
            
            // Edit customer
            $('#btnEdit').on('click', function() {
                var selectedId = $('.row-select:checked').first().val();
                editCustomer(selectedId);
            });
            
            $(document).on('click', '.edit-btn', function() {
                var customerId = $(this).data('id');
                editCustomer(customerId);
            });
            
            function editCustomer(id) {
                $.get('/api/customer/' + id, function(customer) {
                    $('#customerId').val(customer.id);
                    $('#accountName').val(customer.accountName);
                    $('#accountNo').val(customer.accountNo);
                    $('#companyType').val(customer.companyType);
                    $('#phone').val(customer.phone);
                    $('#email').val(customer.email);
                    $('#customerStatus').val(customer.customerStatus);
                    $('#salesRepresentative').val(customer.salesRepresentative);
                    $('#modalTitle').text('Edit Customer');
                    $('#customerModal').modal('show');
                });
            }
            
            // Delete customer
            $('#btnDelete').on('click', function() {
                var selectedIds = $('.row-select:checked').map(function() {
                    return $(this).val();
                }).get();
                
                MillenniumERP.confirm('Are you sure you want to delete ' + selectedIds.length + ' customer(s)?', function() {
                    deleteCustomers(selectedIds);
                });
            });
            
            $(document).on('click', '.delete-btn', function() {
                var customerId = $(this).data('id');
                MillenniumERP.confirm('Are you sure you want to delete this customer?', function() {
                    deleteCustomers([customerId]);
                });
            });
            
            function deleteCustomers(ids) {
                $.ajax({
                    url: '/api/customer',
                    type: 'DELETE',
                    data: JSON.stringify(ids),
                    contentType: 'application/json',
                    success: function() {
                        MillenniumERP.showNotification('Customer(s) deleted successfully', 'success');
                        loadCustomers();
                    },
                    error: function() {
                        MillenniumERP.showNotification('Error deleting customer(s)', 'danger');
                    }
                });
            }
            
            // Save customer
            $('#btnSave').on('click', function() {
                var customer = {
                    id: $('#customerId').val(),
                    accountName: $('#accountName').val(),
                    accountNo: $('#accountNo').val(),
                    companyType: $('#companyType').val(),
                    companyRegistrationNo: $('#companyRegistrationNo').val(),
                    vatRegistrationNo: $('#vatRegistrationNo').val(),
                    phone: $('#phone').val(),
                    email: $('#email').val(),
                    customerStatus: $('#customerStatus').val(),
                    salesRepresentative: $('#salesRepresentative').val(),
                    isActive: $('#isActive').is(':checked')
                };
                
                var url = customer.id ? '/api/customer/' + customer.id : '/api/customer';
                var method = customer.id ? 'PUT' : 'POST';
                
                $.ajax({
                    url: url,
                    type: method,
                    data: JSON.stringify(customer),
                    contentType: 'application/json',
                    success: function() {
                        $('#customerModal').modal('hide');
                        MillenniumERP.showNotification('Customer saved successfully', 'success');
                        loadCustomers();
                    },
                    error: function() {
                        MillenniumERP.showNotification('Error saving customer', 'danger');
                    }
                });
            });
            
            // Refresh
            $('#btnRefresh').on('click', function() {
                loadCustomers();
            });
            
            // Export to Excel
            $('#btnExport').on('click', function() {
                window.location.href = '/api/customer/export';
            });
        });
    </script>
}