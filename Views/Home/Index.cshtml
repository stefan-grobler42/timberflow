@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<div id="wrapper">
    <!-- Page Content (full width) -->
    <div id="content" class="content-area-fullwidth">
        <!-- Top Navigation Bar with Hamburger Menu -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light top-navbar">
            <div class="container-fluid">
                <!-- Left side: Logo, Hamburger Menu -->
                <div class="d-flex align-items-center">
                    <img src="/millennium-logo.png" alt="Millennium" class="navbar-logo me-2" style="height: 32px;">
                    <span class="navbar-brand mb-0">Millennium ERP</span>
                    
                    <!-- Hamburger Menu Dropdown -->
                    <div class="dropdown ms-3">
                        <button class="btn btn-link hamburger-menu" id="navMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-bars fa-lg"></i>
                        </button>
                        <div class="dropdown-menu nav-dropdown-menu" aria-labelledby="navMenuButton">
                            <!-- CRM Section -->
                            <h6 class="dropdown-header">
                                <i class="fas fa-users"></i> CRM
                            </h6>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="customer">
                                <i class="fas fa-user-tie"></i> Customers
                            </a>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="contact">
                                <i class="fas fa-address-book"></i> Contacts
                            </a>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="employee">
                                <i class="fas fa-id-badge"></i> Employees
                            </a>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="users">
                                <i class="fas fa-users-cog"></i> Users
                            </a>
                            <div class="dropdown-divider"></div>
                            
                            <!-- Projects Section -->
                            <h6 class="dropdown-header">
                                <i class="fas fa-project-diagram"></i> Projects
                            </h6>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="project">
                                <i class="fas fa-building"></i> Projects
                            </a>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="quote">
                                <i class="fas fa-file-invoice-dollar"></i> Quotes
                            </a>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="order">
                                <i class="fas fa-shopping-cart"></i> Orders
                            </a>
                            <div class="dropdown-divider"></div>
                            
                            <!-- Inventory Section -->
                            <h6 class="dropdown-header">
                                <i class="fas fa-warehouse"></i> Inventory
                            </h6>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="product">
                                <i class="fas fa-cube"></i> Products
                            </a>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="stock">
                                <i class="fas fa-boxes"></i> Stock Items
                            </a>
                            <div class="dropdown-divider"></div>
                            
                            <!-- Administration Section -->
                            <h6 class="dropdown-header">
                                <i class="fas fa-cogs"></i> Administration
                            </h6>
                            <a class="dropdown-item nav-menu-link" href="#" data-module="settings">
                                <i class="fas fa-sliders-h"></i> Settings
                            </a>
                        </div>
                    </div>
                </div>
                
                <!-- Right side: User menu -->
                <div class="ms-auto d-flex align-items-center">
                    <div class="dropdown">
                        <button class="btn btn-link dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="fas fa-user-circle"></i> Admin User
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-user"></i> Profile</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cog"></i> Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div class="container-fluid mt-3" id="mainContent">
            <!-- Dynamic content will be loaded here -->
            <div class="welcome-screen">
                <h1>Welcome to Millennium Timber Roof ERP</h1>
                <p class="lead">Select a module from the menu above or click a card below to begin</p>
                
                <div class="row mt-5">
                    <div class="col-md-4">
                        <div class="card module-card" data-module="customer">
                            <div class="card-body text-center">
                                <i class="fas fa-user-tie fa-3x text-primary mb-3"></i>
                                <h5 class="card-title">Customer Management</h5>
                                <p class="card-text">Manage customer information, contacts, and relationships</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card module-card" data-module="quote">
                            <div class="card-body text-center">
                                <i class="fas fa-file-invoice-dollar fa-3x text-success mb-3"></i>
                                <h5 class="card-title">Quotations</h5>
                                <p class="card-text">Create and manage quotations for customers</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card module-card" data-module="project">
                            <div class="card-body text-center">
                                <i class="fas fa-building fa-3x text-warning mb-3"></i>
                                <h5 class="card-title">Projects</h5>
                                <p class="card-text">Track and manage construction projects</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Customer Templates (Hidden) -->
<div id="templates" style="display: none;">
    <!-- Customer List View Template -->
    <div id="customerListTemplate">
        <div class="module-header mb-3">
            <h2><i class="fas fa-user-tie"></i> Customer Management</h2>
            <p class="text-muted">Manage customer information and relationships</p>
        </div>
        
        <!-- Action Bar -->
        <div class="action-bar mb-3">
            <div class="action-group">
                <button class="btn btn-primary btn-sm" onclick="CustomerModule.newRecord()">
                    <i class="fas fa-plus"></i> New
                </button>
                <button class="btn btn-outline-primary btn-sm" onclick="CustomerModule.editRecord()" id="btnEdit" disabled>
                    <i class="fas fa-edit"></i> Edit
                </button>
                <button class="btn btn-outline-danger btn-sm" onclick="CustomerModule.deleteRecord()" id="btnDelete" disabled>
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
            
            <div class="action-separator"></div>
            
            <div class="action-group">
                <button class="btn btn-outline-secondary btn-sm" onclick="CustomerModule.refreshGrid()">
                    <i class="fas fa-sync"></i> Refresh
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="CustomerModule.showFilter()">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="CustomerModule.columnSelector()">
                    <i class="fas fa-columns"></i> Columns
                </button>
            </div>
            
            <div class="action-separator"></div>
            
            <div class="action-group">
                <button class="btn btn-outline-success btn-sm" onclick="CustomerModule.exportExcel()">
                    <i class="fas fa-file-excel"></i> Export
                </button>
                <button class="btn btn-outline-info btn-sm" onclick="CustomerModule.importData()">
                    <i class="fas fa-file-import"></i> Import
                </button>
            </div>
            
            <div class="action-search ms-auto">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search customers..." id="customerSearch">
                </div>
            </div>
        </div>
        
        <!-- Data Grid -->
        <div class="card">
            <div class="card-body p-0">
                <table id="customerGrid" class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th width="30" style="width: 30px; min-width: 30px; max-width: 30px;">
                                <input type="checkbox" class="form-check-input" id="selectAll">
                            </th>
                            <th>Account #</th>
                            <th>Account Name</th>
                            <th>Company Type</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Sales Rep</th>
                            <th>Credit Limit</th>
                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- Users List View Template -->
    <div id="usersListTemplate">
        <div class="module-header mb-3">
            <h2><i class="fas fa-users-cog"></i> User Management</h2>
            <p class="text-muted">Manage system users, roles and permissions</p>
        </div>
        
        <!-- Action Bar -->
        <div class="action-bar mb-3">
            <div class="action-group">
                <button class="btn btn-primary btn-sm" onclick="UsersModule.newRecord()">
                    <i class="fas fa-plus"></i> New
                </button>
                <button class="btn btn-outline-primary btn-sm" onclick="UsersModule.editRecord()" id="btnEditUser" disabled>
                    <i class="fas fa-edit"></i> Edit
                </button>
                <button class="btn btn-outline-danger btn-sm" onclick="UsersModule.deleteRecord()" id="btnDeleteUser" disabled>
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
            
            <div class="action-separator"></div>
            
            <div class="action-group">
                <button class="btn btn-outline-secondary btn-sm" onclick="UsersModule.refreshGrid()">
                    <i class="fas fa-sync"></i> Refresh
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="UsersModule.showFilter()">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="UsersModule.columnSelector()">
                    <i class="fas fa-columns"></i> Columns
                </button>
            </div>
            
            <div class="action-separator"></div>
            
            <div class="action-group">
                <button class="btn btn-outline-success btn-sm" onclick="UsersModule.exportExcel()">
                    <i class="fas fa-file-excel"></i> Export
                </button>
                <button class="btn btn-outline-info btn-sm" onclick="UsersModule.importData()">
                    <i class="fas fa-file-import"></i> Import
                </button>
            </div>
            
            <div class="action-search ms-auto">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search users..." id="userSearch">
                </div>
            </div>
        </div>
        
        <!-- Data Grid -->
        <div class="card">
            <div class="card-body p-0">
                <table id="usersGrid" class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th width="30" style="width: 30px; min-width: 30px; max-width: 30px;">
                                <input type="checkbox" class="form-check-input" id="selectAllUsers">
                            </th>
                            <th>User Code</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Position</th>
                            <th>Role</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Hire Date</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- Settings List View Template -->
    <div id="settingsListTemplate">
        <div class="module-header mb-3">
            <h2><i class="fas fa-sliders-h"></i> Settings Management</h2>
            <p class="text-muted">Manage lookup tables and system settings</p>
        </div>
        
        <!-- Settings Tabs -->
        <ul class="nav nav-tabs" id="settingsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="company-types-tab" data-bs-toggle="tab" data-bs-target="#company-types" type="button" role="tab">
                    <i class="fas fa-building"></i> Company Types
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="account-types-tab" data-bs-toggle="tab" data-bs-target="#account-types" type="button" role="tab">
                    <i class="fas fa-user-tag"></i> Account Types
                </button>
            </li>
        </ul>
        
        <!-- Tab Content -->
        <div class="tab-content" id="settingsTabsContent">
            <!-- Company Types Tab -->
            <div class="tab-pane fade show active" id="company-types" role="tabpanel">
                <div class="action-bar mb-3 mt-3">
                    <div class="action-group">
                        <button class="btn btn-primary btn-sm" onclick="SettingsModule.newCompanyType()">
                            <i class="fas fa-plus"></i> New Company Type
                        </button>
                        <button class="btn btn-outline-primary btn-sm" onclick="SettingsModule.editCompanyType()" id="btnEditCompanyType" disabled>
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button class="btn btn-outline-danger btn-sm" onclick="SettingsModule.deleteCompanyType()" id="btnDeleteCompanyType" disabled>
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </div>
                    
                    <div class="action-search ms-auto">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control" placeholder="Search company types..." id="companyTypeSearch">
                        </div>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-body p-0">
                        <table id="companyTypesGrid" class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th width="30" style="width: 30px; min-width: 30px; max-width: 30px;">
                                        <input type="checkbox" class="form-check-input" id="selectAllCompanyTypes">
                                    </th>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Account Types Tab -->
            <div class="tab-pane fade" id="account-types" role="tabpanel">
                <div class="action-bar mb-3 mt-3">
                    <div class="action-group">
                        <button class="btn btn-primary btn-sm" onclick="SettingsModule.newAccountType()">
                            <i class="fas fa-plus"></i> New Account Type
                        </button>
                        <button class="btn btn-outline-primary btn-sm" onclick="SettingsModule.editAccountType()" id="btnEditAccountType" disabled>
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button class="btn btn-outline-danger btn-sm" onclick="SettingsModule.deleteAccountType()" id="btnDeleteAccountType" disabled>
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </div>
                    
                    <div class="action-search ms-auto">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control" placeholder="Search account types..." id="accountTypeSearch">
                        </div>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-body p-0">
                        <table id="accountTypesGrid" class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th width="30" style="width: 30px; min-width: 30px; max-width: 30px;">
                                        <input type="checkbox" class="form-check-input" id="selectAllAccountTypes">
                                    </th>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>