@{
    ViewData["Title"] = "Millennium Timber Roof ERP";
    Layout = "_LayoutSPA";
}

<div id="app-container">
    <!-- Default welcome screen -->
    <div id="module-content" class="h-100">
        <div class="d-flex flex-column align-items-center justify-content-center h-100">
            <img src="/millennium-logo.png" alt="Millennium" style="width: 200px; margin-bottom: 30px;">
            <h1 class="text-primary mb-4">Welcome to Millennium Timber Roof ERP</h1>
            <p class="lead text-muted mb-5">Select a module from the sidebar to begin</p>
            
            <div class="row g-4" style="max-width: 800px;">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-users fa-3x text-primary mb-3"></i>
                            <h5>Customer Management</h5>
                            <p class="text-muted small">Manage customers, contacts, and relationships</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-file-invoice-dollar fa-3x text-success mb-3"></i>
                            <h5>Quotes & Orders</h5>
                            <p class="text-muted small">Create quotes, manage orders and tenders</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-warehouse fa-3x text-info mb-3"></i>
                            <h5>Inventory</h5>
                            <p class="text-muted small">Track products, stock levels and categories</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>