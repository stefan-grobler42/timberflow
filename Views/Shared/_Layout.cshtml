<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Millennium Timber Roof ERP</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/millennium.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
        <div class="container-fluid">
            <button class="btn btn-link text-white me-3" id="sidebarToggle" title="Toggle Sidebar">
                <i class="fas fa-bars"></i>
            </button>
            <a class="navbar-brand" href="/">
                <img src="/millennium-logo.png" alt="Millennium" height="30" class="d-inline-block align-text-top me-2">
                Millennium Timber Roof ERP
            </a>
            <div class="ms-auto d-flex align-items-center">
                <div class="dropdown me-3">
                    <button class="btn btn-link text-white dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-user"></i> Admin User
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-user-cog"></i> Profile</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-cog"></i> Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Layout with Sidebar -->
    <div class="main-wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-content">
                <!-- CRM Section -->
                <div class="sidebar-section">
                    <h6 class="sidebar-heading">
                        <i class="fas fa-users"></i> CRM
                    </h6>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="/Customer" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" ? "active" : "")">
                                <i class="fas fa-user-tie"></i>
                                <span>Customers</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Contact" class="sidebar-link">
                                <i class="fas fa-address-book"></i>
                                <span>Contacts</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Employee" class="sidebar-link">
                                <i class="fas fa-id-badge"></i>
                                <span>Employees</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Projects Section -->
                <div class="sidebar-section">
                    <h6 class="sidebar-heading">
                        <i class="fas fa-project-diagram"></i> Projects
                    </h6>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="/Project" class="sidebar-link">
                                <i class="fas fa-building"></i>
                                <span>Projects</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Quote" class="sidebar-link">
                                <i class="fas fa-file-invoice-dollar"></i>
                                <span>Quotes</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Order" class="sidebar-link">
                                <i class="fas fa-shopping-cart"></i>
                                <span>Orders</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Inventory Section -->
                <div class="sidebar-section">
                    <h6 class="sidebar-heading">
                        <i class="fas fa-warehouse"></i> Inventory
                    </h6>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="/Product" class="sidebar-link">
                                <i class="fas fa-cube"></i>
                                <span>Products</span>
                            </a>
                        </li>
                        <li>
                            <a href="/StockItem" class="sidebar-link">
                                <i class="fas fa-boxes"></i>
                                <span>Stock Items</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Category" class="sidebar-link">
                                <i class="fas fa-tags"></i>
                                <span>Categories</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Settings Section -->
                <div class="sidebar-section">
                    <h6 class="sidebar-heading">
                        <i class="fas fa-cog"></i> Settings
                    </h6>
                    <ul class="sidebar-menu">
                        <li>
                            <a href="/CompanyType" class="sidebar-link">
                                <i class="fas fa-building-circle-check"></i>
                                <span>Company Types</span>
                            </a>
                        </li>
                        <li>
                            <a href="/AccountType" class="sidebar-link">
                                <i class="fas fa-user-cog"></i>
                                <span>Account Types</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div id="content" class="content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    
    <!-- Custom Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>