<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Millennium Timber Roof ERP</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/spa.css" />
    
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top" style="z-index: 1030;">
        <div class="container-fluid">
            <button class="btn btn-link text-white me-3" id="sidebar-toggle" title="Toggle Sidebar">
                <i class="fas fa-bars"></i>
            </button>
            <a class="navbar-brand" href="/">
                <img src="/millennium-logo.png" alt="Millennium" height="30" class="d-inline-block align-text-top me-2">
                Millennium Timber Roof ERP
            </a>
            <div class="ms-auto d-flex align-items-center">
                <div class="dropdown me-3">
                    <button class="btn btn-link text-white dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-cog"></i> Sidebar: <span id="sidebar-mode-text">Always Show</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item sidebar-mode-option" href="#" data-mode="always">Always Show</a></li>
                        <li><a class="dropdown-item sidebar-mode-option" href="#" data-mode="minimized">Minimized</a></li>
                        <li><a class="dropdown-item sidebar-mode-option" href="#" data-mode="hover">View on Hover</a></li>
                    </ul>
                </div>
                <span class="text-white me-3">
                    <i class="fas fa-user"></i> Admin User
                </span>
            </div>
        </div>
    </nav>

    <!-- Main Layout with Collapsible Sidebar -->
    <div class="d-flex" style="margin-top: 56px; height: calc(100vh - 56px);">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar bg-light border-end">
            <div class="sidebar-content p-3">
                <h6 class="text-uppercase text-muted mb-3 sidebar-text">Main Menu</h6>
                
                <!-- CRM Section -->
                <div class="mb-3">
                    <h6 class="text-primary mb-2 sidebar-text"><i class="fas fa-users"></i> <span class="sidebar-label">CRM</span></h6>
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="Customer">
                            <i class="fas fa-user-tie me-2"></i> <span class="sidebar-label">Customers</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="Contact">
                            <i class="fas fa-address-book me-2"></i> <span class="sidebar-label">Contacts</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="Employee">
                            <i class="fas fa-id-badge me-2"></i> <span class="sidebar-label">Employees</span>
                        </a>
                    </div>
                </div>
                
                <!-- Projects Section -->
                <div class="mb-3">
                    <h6 class="text-primary mb-2 sidebar-text"><i class="fas fa-project-diagram"></i> <span class="sidebar-label">Projects</span></h6>
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="Project">
                            <i class="fas fa-building me-2"></i> <span class="sidebar-label">Projects</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="Quote">
                            <i class="fas fa-file-invoice-dollar me-2"></i> <span class="sidebar-label">Quotes</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="Tender">
                            <i class="fas fa-gavel me-2"></i> <span class="sidebar-label">Tenders</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="Order">
                            <i class="fas fa-shopping-cart me-2"></i> <span class="sidebar-label">Orders</span>
                        </a>
                    </div>
                </div>
                
                <!-- Inventory Section -->
                <div class="mb-3">
                    <h6 class="text-primary mb-2 sidebar-text"><i class="fas fa-warehouse"></i> <span class="sidebar-label">Inventory</span></h6>
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="Product">
                            <i class="fas fa-cube me-2"></i> <span class="sidebar-label">Products</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="StockItem">
                            <i class="fas fa-boxes me-2"></i> <span class="sidebar-label">Stock Items</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action py-2 module-link" data-module="Category">
                            <i class="fas fa-tags me-2"></i> <span class="sidebar-label">Categories</span>
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Hover trigger zone for auto-show -->
            <div id="sidebar-hover-zone"></div>
        </nav>
        
        <!-- Main Content Area -->
        <div id="main-content" class="flex-fill" style="background-color: #f8f9fa; overflow-y: auto;">
            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- Google Maps -->
    <script>
        function initMap() {
            // Google Maps will be initialized when needed
        }
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBVqg9EqO9p0gd4mJJLu9s7sZdF-Q_5gjQ&libraries=places&callback=initMap" async defer></script>
    
    <!-- SPA Navigation Script -->
    <script src="~/js/spa-navigation.js"></script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>